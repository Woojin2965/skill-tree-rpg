{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowledge-rpg",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Same region as the Neon database, so several queries cost one long hop instead of several.
  "placement": { "region": "aws:us-west-2" },
  // Stops a request that gets past the grader's input checks. Needs Workers Paid.
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace with the real ID from `wrangler hyperdrive create` before deploying.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:local@localhost:5433/knowledge_rpg"
    }
  ]
}
